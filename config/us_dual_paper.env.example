# 100만 원 미국 주식 전용 로컬 PAPER 프로필. 실제 주문을 전송하지 않습니다.
# 프로젝트 루트의 .env에 필요한 값을 복사하세요. 비밀키를 Git에 올리지 마세요.
AIPRO_RUNTIME=US_DUAL
AIPRO_MODE=PAPER
AIPRO_INITIAL_CASH_KRW=1000000
AIPRO_LIVE_CONFIRM=NO
ENABLE_LIVE_TRADING=0
AIPRO_US_DUAL_DB_PATH=data/us_dual_paper.sqlite3
AIPRO_US_FRAME_PATH=data/us_market_frame.json
# 0 = 1회 실행; 1~60 = 반복 간격. 시세 공급기가 파일을 원자적으로 갱신해야 합니다.
AIPRO_PAPER_INTERVAL_SECONDS=30
AIPRO_TELEGRAM_BOT_TOKEN=
AIPRO_TELEGRAM_ALLOWED_CHAT_IDS=
# 선택적 실데이터 검증 모델. 둘 다 비워 두면 기존 미학습 규칙을 사용합니다.
# model.json 최상위 fingerprint 값을 넣으며, 합성 모델은 기본 운용에서 거부합니다.
AIPRO_US_MODEL_PATH=
AIPRO_US_MODEL_SHA256=
