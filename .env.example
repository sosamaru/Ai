# AiPro safe local-development defaults
# Copy to .env only for local use. Never commit real credentials or tokens.

# Runtime mode: keep PAPER unless a separately reviewed LIVE stage is approved.
AIPRO_MODE=PAPER
AIPRO_INITIAL_CASH_KRW=1000000
AIPRO_MAX_POSITIONS=2
AIPRO_MAX_POSITION_PCT=0.40
AIPRO_DAILY_LOSS_LIMIT_PCT=-10.0
AIPRO_MIN_ORDER_KRW=5000

# Persistent state and logs
AIPRO_DB_PATH=data/aipro.db
AIPRO_LOG_DIR=logs
AIPRO_LOG_LEVEL=INFO

# LIVE dual lock: both values intentionally disable LIVE operation.
AIPRO_LIVE_CONFIRM=NO
ENABLE_LIVE_TRADING=0

# Telegram remains disabled while the token is blank.
AIPRO_TELEGRAM_BOT_TOKEN=
AIPRO_TELEGRAM_ALLOWED_CHAT_IDS=
AIPRO_TELEGRAM_POLL_TIMEOUT_SEC=25

# Market-data defaults use deterministic demo data.
AIPRO_MARKET_DATA_PROVIDER=DEMO
AIPRO_CRYPTO_SYMBOLS=KRW-BTC,KRW-ETH,KRW-XRP
AIPRO_MARKET_DATA_TIMEOUT_SEC=5.0
AIPRO_MARKET_DATA_MAX_ATTEMPTS=3
AIPRO_MARKET_DATA_MAX_LATENCY_SEC=10.0
AIPRO_MARKET_DATA_MAX_SNAPSHOT_AGE_SEC=120.0
AIPRO_MARKET_DATA_MAX_CONSECUTIVE_FAILURES=3

# Service credentials, API keys, SMTP secrets, TOTP recovery material, broker
# credentials, and SEC contact identities must be supplied through an approved
# local secret store, CI/VPS secret manager, or environment injection. Do not
# add real values to this example file.
